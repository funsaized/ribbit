{
  "name": "ribbit",
  "version": "0.1.0-alpha.2",
  "private": true,
  "description": "An extensible framework for composing model tasks into reusable commands with typed contracts and inspectable evidence",
  "homepage": "https://github.com/funsaized/ribbit#readme",
  "bugs": {
    "url": "https://github.com/funsaized/ribbit/issues"
  },
  "license": "MIT",
  "author": "Sai Nimmagadda",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/funsaized/ribbit.git"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build": "bun run scripts/build.ts",
    "test:unit": "bun test tests/unit tests/records tests/execution tests/sdk tests/routing tests/providers tests/manifests tests/extensions tests/builtins tests/filesystem tests/flows tests/definitions tests/scaffold tests/evals",
    "test:consumer": "bun test tests/consumer",
    "test:cli": "bun test tests/cli",
    "test:conformance": "bun test tests/conformance",
    "test:docs": "bun run scripts/docs.ts",
    "bench": "bun run scripts/bench.ts",
    "package:smoke": "bun run scripts/smoke.ts",
    "test:release": "bun test tests/release",
    "eval:release": "bun run scripts/release/evaluate.ts",
    "eval:regrade": "bun run scripts/release/regrade.ts",
    "package:release": "bun run scripts/release/package.ts",
    "verify": "bun run scripts/verify.ts",
    "eval:workflows": "bun run scripts/release/workflows.ts",
    "eval:handoff": "bun run scripts/release/handoff.ts",
    "notices": "bun run scripts/release/notices.ts",
    "package:verify": "bun run scripts/release/archive-smoke.ts",
    "package:npm": "bun run scripts/release/npm.ts",
    "package:npm:verify": "bun run scripts/release/npm-smoke.ts"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "ignore": "7.0.5",
    "yaml": "2.8.3",
    "zod": "4.1.13"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bun": "1.3.3",
    "@types/node": "24.10.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.83.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": "1.4.0"
  }
}
